# Public development/preview bind address; not an application secret.
VITE_HOST=127.0.0.1
# Development/preview HTTP port.
VITE_PORT=5173
# Playwright target URL; keep its port aligned with PLAYWRIGHT_PORT.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173
# Port for the Playwright-managed Vite server.
PLAYWRIGHT_PORT=5173
